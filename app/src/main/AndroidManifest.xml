<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ML Kit requires DataTransport classes but its network and scheduler manifest entries are forbidden. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!--
      largeHeap is required, not decorative: compositing a full-resolution target holds
      four full-frame Int/Float arrays at once (see ImageMemoryBudget). On a 2 GB-class
      device the default 192 MB growth limit would cap every photo at roughly 5 MP, which
      contradicts §5.2's requirement to keep the target's own resolution. The adaptive
      budget still reads the real Runtime.maxMemory(), so this raises the ceiling without
      removing the limit.
    -->
    <application
        android:allowBackup="false"
        android:largeHeap="true"
        android:icon="@drawable/ic_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.FaceSwapLocal">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            tools:node="remove" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            tools:node="remove" />
    </application>

</manifest>

